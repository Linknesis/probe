; Linknesis Windows Probe Installer
; Generated by the Core on demand. Do not edit manually.

!include "LogicLib.nsh"

!define APP_NAME "Linknesis Probe"
!define APP_PUBLISHER "Linknesis"
; The Core passes -DAPP_VERSION=<its version> (shown in Installed apps).
!ifndef APP_VERSION
  !define APP_VERSION "1.0.0"
!endif
!define TASK_NAME "LinknesisProbe"

Name "${APP_NAME}"
RequestExecutionLevel admin
SetCompressor lzma

; Defaults for standalone compilation. The Core overrides these via -D defines.
!ifndef PROBE_CORE_ADDRESS
  !define PROBE_CORE_ADDRESS "core.example.com:4443"
!endif
!ifndef PROBE_HASH
  !define PROBE_HASH "changeme"
!endif
!ifndef ASSETS_DIR
  !define ASSETS_DIR "."
!endif
!ifndef OUT_FILE
  !define OUT_FILE "linknesis-probe-setup.exe"
!endif

OutFile "${OUT_FILE}"
InstallDir "$PROGRAMFILES64\Linknesis Probe"

LicenseText "Third-party licenses"
LicenseData "${ASSETS_DIR}\LICENSE-THIRD-PARTY.txt"

Page license
Page directory
Page instfiles

Section "Install"
  ; Stop any running probe instance and clean up previous task/service
  DetailPrint "Stopping any running Linknesis Probe processes..."
  nsExec::ExecToLog 'taskkill /f /im linknesis-probe.exe'
  Pop $0
  nsExec::ExecToLog 'sc stop ${TASK_NAME}'
  Pop $0
  nsExec::ExecToLog 'sc delete ${TASK_NAME}'
  Pop $0
  nsExec::ExecToLog 'schtasks /end /tn ${TASK_NAME}'
  Pop $0
  nsExec::ExecToLog 'schtasks /delete /tn ${TASK_NAME} /f'
  Pop $0

  SetOutPath "$INSTDIR"
  File "${ASSETS_DIR}\linknesis-probe.exe"
  File "${ASSETS_DIR}\linknesis.ico"
  File "${ASSETS_DIR}\LICENSE-THIRD-PARTY.txt"
  File "${ASSETS_DIR}\iperf3_license.txt"
  File "${ASSETS_DIR}\create-task.ps1"
  File "${ASSETS_DIR}\ensure-mtr-firewall-rules.ps1"

  DetailPrint "Installing iperf3 runtime..."
  File "${ASSETS_DIR}\iperf3.exe"
  File "${ASSETS_DIR}\*.dll"

  ; TCP/UDP MTR depends entirely on these four inbound rules to see ICMP
  ; Time Exceeded/Destination Unreachable replies -- a silent failure here
  ; (or a later Windows feature upgrade resetting them, see
  ; ensure-mtr-firewall-rules.ps1's own comment) leaves those two protocols
  ; running but effectively broken with no visible error. Run the verifying
  ; script and surface its exit code instead of the old fire-and-forget
  ; -ErrorAction SilentlyContinue calls, which swallowed every failure.
  DetailPrint "Creating firewall rules for MTR..."
  nsExec::ExecToLog 'powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File "$INSTDIR\ensure-mtr-firewall-rules.ps1"'
  Pop $1
  ${If} $1 != 0
    DetailPrint "WARNING: one or more MTR firewall rules could not be created -- see $LOCALAPPDATA\Linknesis\install.log. TCP/UDP MTR will still run but may be very slow (every hop before the target times out). Re-run this installer as Administrator, or check Windows Defender Firewall."
  ${EndIf}

  DetailPrint "Registering ${TASK_NAME} scheduled task..."
  nsExec::ExecToLog 'powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File "$INSTDIR\create-task.ps1" -CoreAddress "${PROBE_CORE_ADDRESS}" -ProbeHash "${PROBE_HASH}"'
  Pop $0

  DetailPrint "Writing install log..."
  CreateDirectory "$LOCALAPPDATA\Linknesis"
  FileOpen $R0 "$LOCALAPPDATA\Linknesis\install.log" w
  FileWrite $R0 "Task creation rc=$0$\r$\n"
  FileWrite $R0 "MTR firewall rules rc=$1$\r$\n"
  FileClose $R0

  Delete "$INSTDIR\create-task.ps1"
  ; ensure-mtr-firewall-rules.ps1 is kept (not deleted here) -- the
  ; Uninstall section below needs its own copy to remove these same rules
  ; with the same verified logic, and deletes it itself once done.

  WriteUninstaller "$INSTDIR\uninstall.exe"

  DetailPrint "Creating Start Menu shortcut..."
  CreateDirectory "$SMPROGRAMS\${APP_NAME}"
  CreateShortcut "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk" "$INSTDIR\linknesis-probe.exe" "--core ${PROBE_CORE_ADDRESS} --hash ${PROBE_HASH}" "$INSTDIR\linknesis.ico"

  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "DisplayName" "${APP_NAME}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "DisplayIcon" "$INSTDIR\linknesis.ico"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "Publisher" "${APP_PUBLISHER}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}" "InstallLocation" "$INSTDIR"
SectionEnd

Section "Uninstall"
  DetailPrint "Stopping and removing ${TASK_NAME} task..."
  nsExec::ExecToLog 'taskkill /f /im linknesis-probe.exe'
  Pop $0
  nsExec::ExecToLog 'schtasks /end /tn ${TASK_NAME}'
  Pop $0
  nsExec::ExecToLog 'schtasks /delete /tn ${TASK_NAME} /f'
  Pop $0
  nsExec::ExecToLog 'sc stop ${TASK_NAME}'
  Pop $0
  nsExec::ExecToLog 'sc delete ${TASK_NAME}'
  Pop $0

  ; DSCP QoS policies the probe adds per iperf3 test (windows_qos.zig) live in
  ; the non-persistent ActiveStore and are removed when each test ends; this
  ; only catches one left by a test that was running when the probe was killed
  ; above, so it doesn't stay until the next reboot.
  DetailPrint "Removing leftover DSCP QoS policies..."
  nsExec::ExecToLog `powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "Get-NetQosPolicy -PolicyStore ActiveStore -ErrorAction SilentlyContinue | Where-Object { $$_.Name -like 'Linknesis iperf3 *' } | Remove-NetQosPolicy -PolicyStore ActiveStore -Confirm:$$false"`
  Pop $0

  ; The old plain Remove-NetFirewallRule -ErrorAction SilentlyContinue calls
  ; (no verification at all) left all four rules behind on a real
  ; uninstall+reboot, the same silent-failure
  ; class as the old install-time creation calls. Use the same shared,
  ; verifying script (in -Remove mode) instead.
  DetailPrint "Removing MTR firewall rules..."
  nsExec::ExecToLog 'powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File "$INSTDIR\ensure-mtr-firewall-rules.ps1" -Remove'
  Pop $2
  ${If} $2 != 0
    DetailPrint "WARNING: one or more MTR firewall rules could not be removed -- see $LOCALAPPDATA\Linknesis\uninstall.log. Remove them manually via Windows Defender Firewall with Advanced Security if desired."
  ${EndIf}

  DetailPrint "Writing uninstall log..."
  CreateDirectory "$LOCALAPPDATA\Linknesis"
  FileOpen $R0 "$LOCALAPPDATA\Linknesis\uninstall.log" w
  FileWrite $R0 "MTR firewall rules removal rc=$2$\r$\n"
  FileClose $R0

  Delete "$INSTDIR\linknesis-probe.exe"
  Delete "$INSTDIR\iperf3.exe"
  Delete "$INSTDIR\*.dll"
  Delete "$INSTDIR\linknesis.ico"
  Delete "$INSTDIR\LICENSE-THIRD-PARTY.txt"
  Delete "$INSTDIR\iperf3_license.txt"
  Delete "$INSTDIR\config.json"
  ; The probe's actual runtime log is linknesis-debug.log, not
  ; linknesis-probe.log (which nothing ever writes) -- fixed alongside the
  ; firewall-rule bug above since it's the reason RMDir below never actually
  ; removed $INSTDIR on a real uninstall (a non-empty directory is left
  ; behind instead: linknesis-debug.log and update.ps1 --
  ; the temp helper updater.zig's applyWindowsUpdate writes for a
  ; self-update, see probe/src/updater.zig -- both survived every uninstall
  ; run to date).
  Delete "$INSTDIR\linknesis-debug.log"
  Delete "$INSTDIR\update.ps1"
  Delete "$INSTDIR\ensure-mtr-firewall-rules.ps1"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"

  ; Remove probe state/logs from the legacy C:\linknesis location
  Delete "C:\linknesis\config.json"
  Delete "C:\linknesis\linknesis-debug.log"

  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${TASK_NAME}"
SectionEnd
